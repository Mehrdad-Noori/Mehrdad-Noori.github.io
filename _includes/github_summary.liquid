<!-- GitHub Stats -->
<div style="display: flex; justify-content: center; align-items: flex-start; margin-top: 0px;">
  <div style="width: 100%; max-width: 480px;">
    <a href="https://github.com/anuraghazra/github-readme-stats" target="_blank">
      <!-- Light mode -->
      <img
        class="repo-img-light"
        src="https://meno-stats.vercel.app/api?username=Mehrdad-Noori&include_all_commits=true&show_icons=true&theme={{ site.repo_theme_light }}"
        alt="{{ include.username }}"
        style="width: 100%; height: auto;"
      >

      <!-- Dark mode -->
      <img
        class="repo-img-dark"
        src="https://meno-stats.vercel.app/api?username=Mehrdad-Noori&include_all_commits=true&show_icons=true&theme={{ site.repo_theme_dark }}"
        alt="{{ include.username }}"
        style="width: 100%; height: auto;"
      >
    </a>
  </div>
</div>

<div style="display: flex; justify-content: center; align-items: center; margin-top: 10px; width: 100%;">
  <a href="https://github.com/ryo-ma/github-profile-trophy" style="width: 100%; max-width: 900px;">
    <!-- Light mode image -->
    <img
      class="repo-img-light"
      style="width: 100%; height: auto;"
      src="https://github-profile-trophy-blush-nine.vercel.app/?username=Mehrdad-Noori&title=Stars,Followers,Commits,Experience,Followers,Repositories,PullRequest,-?&theme={{ site.repo_trophies.theme_light }}&locale={{ site.lang }}&margin-w=2&margin-h=0&no-bg=true&rank=-C&column=6"
      alt="GitHub Trophies"
    >

    <!-- Dark mode image -->
    <img
      class="repo-img-dark"
      style="width: 100%; height: auto;"
      src="https://github-profile-trophy-blush-nine.vercel.app/?username=Mehrdad-Noori&title=Stars,Followers,Commits,Experience,Followers,Repositories,PullRequest,-?&theme={{ site.repo_trophies.theme_dark }}&locale={{ site.lang }}&margin-w=2&margin-h=0&no-bg=true&rank=-C&column=6"
      alt="GitHub Trophies (Dark)"
    >
  </a>
</div>
